<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main>
    <h1><%= titulo %></h1>
    <p class="sub">Parte 1 · Módulo 6 — servidor Node.js + Express funcionando.</p>
    <p>Respuesta generada el <strong><%= fecha %></strong>.</p>

    <h2>Rutas disponibles</h2>
    <table>
      <thead><tr><th>Método</th><th>Ruta</th><th>Descripción</th></tr></thead>
      <tbody>
        <% rutas.forEach(r => { %>
          <tr>
            <td><code><%= r.metodo %></code></td>
            <td><a href="<%= r.ruta %>"><code><%= r.ruta %></code></a></td>
            <td><%= r.descripcion %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <p><a href="/estatico.html">Ver archivo estático servido desde /public</a></p>
  </main>
</body>
</html>
