    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/seed.js --reset"
  },
  "keywords": [
    "nodejs",
    "express",
    "backend",
    "ejs",
    "dotenv",
    "postgresql",
    "sequelize",
    "rest-api"
