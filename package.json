{
  "name": "tp-integrador-backend",
  "version": "2.0.0",
  "description": "TP Integrador Backend - Partes 1 y 2 (Módulos 6 y 7): servidor Node.js + Express, persistencia en archivos planos, PostgreSQL con Sequelize y API REST con CRUD, relaciones 1:1, 1:N y N:M.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
